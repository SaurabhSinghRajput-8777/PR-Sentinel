# PR Sentinel — Environment Configuration

# ==============================================================================
# 1. Supabase (Backend & Auth)
# ==============================================================================
# The Supabase Project URL (Public)
VITE_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# The Supabase Anon/Public Key (Safe for browser client)
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# The Supabase Service Role Key (NEVER expose to frontend or client!)
# Used only in Edge Functions and GitHub Actions workers
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ==============================================================================
# 2. GitHub App Integration
# ==============================================================================
# The numeric GitHub App ID
GITHUB_APP_ID=123456

# The webhook secret configured in GitHub App settings for HMAC verification
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# GitHub App Private Key in PEM format (or Base64 encoded)
# Used to mint installation access tokens server-side
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# GitHub App Client ID & Secret (for OAuth user login if enabled)
GITHUB_CLIENT_ID=Iv1...
GITHUB_CLIENT_SECRET=...

# ==============================================================================
# 3. AI Providers
# ==============================================================================
# Primary default AI provider: 'gemini' | 'ollama' | 'mock'
AI_PROVIDER=gemini

# Google Gemini API Key (Free tier available)
GEMINI_API_KEY=AIzaSy...

# Optional Ollama host URL for local development/airgapped environments
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ==============================================================================
# 4. GitHub Actions Worker Orchestration
# ==============================================================================
# Personal Access Token or App Token used by Supabase Edge Functions to dispatch repository_dispatch
WORKER_DISPATCH_TOKEN=ghp_...
WORKER_REPO_OWNER=your-org
WORKER_REPO_NAME=pr-sentinel

# ==============================================================================
# 5. Dashboard Configuration
# ==============================================================================
VITE_APP_ENV=development
VITE_API_BASE_URL=https://your-project.supabase.co/functions/v1
